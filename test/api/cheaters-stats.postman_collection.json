              "});\r",
              "\r",
              "pm.test(\"El año es 2020\", function () {\r",
              "    const res = pm.response.json();\r",
              "\r",
              "    pm.expect(res).to.have.property(\"data\");\r",
              "    pm.expect(res.data).to.be.an(\"array\");\r",
              "\r",
              "    pm.expect(res.data[0]).to.have.property(\"year\");\r",
              "    pm.expect(res.data[0].year).to.equal(2020);\r",
              "});\r",
              "\r",
              "pm.test(\"El país es Spain\", function () {\r",
              "    const res = pm.response.json();\r",
              "    pm.expect(res).to.have.property(\"data\");\r",
              "    pm.expect(res.data).to.be.an(\"array\").that.is.not.empty;\r",
              "\r",
              "    pm.expect(res.data[0]).to.have.property(\"country\");\r",
              "    pm.expect(res.data[0].country.toLowerCase()).to.equal(\"spain\");\r",

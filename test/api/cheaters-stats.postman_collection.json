          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Devuelve un array\", function () {\r",
              "    const res = pm.response.json();\r",
              "    pm.expect(res).to.be.an('array');\r",
              "});\r",
              "\r",
              "pm.test(\"Array tiene al menos 10 elementos\", function () {\r",
              "    const res = pm.response.json();\r",
              "    pm.expect(res.length).to.be.at.least(10);\r",
              "});\r",
              "\r",
              "pm.test(\"Los objetos tienen la estructura correcta\", function () {\r",
              "    const res = pm.response.json();\r",
              "    const primerElemento = res[0];\r",
              "    pm.expect(primerElemento).to.have.property(\"year\");\r",
              "    pm.expect(primerElemento).to.have.property(\"country\");\r",
              "    pm.expect(primerElemento).to.have.property(\"cheater_reports\");\r",
              "});"
            ],

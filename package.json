  "scripts": {
    "start": "node index.js",
    "dev-front": "cd src/front && npm run dev -- --open",
    "build": "cd src/front && npm install && npm run build",
    "test-DRP": "newman run test/api/esportsgrowth-stats.json -e test/api/local.esportsgrowth-stats_environment.json",
    "test-MRT": "newman run test/api/esportsearnings-stats-v2.postman_collection.json -e test/api/local.esportsearnings-stats_environment.json",
    "test-FMGP": "newman run test/api/v2.cheaters-stats.postman_collection.json -e test/api/local.cheaters-stats_environment.json",
    "test-GGG": "newman run test/api/olympics-athlete-events-collection-v2.json -e test/api/olympics-athlete-events-local.json",
    "test-esportsgrowth-stats": "start-server-and-test start http://localhost:3000 test-DRP",
    "test-esportsearnings-stats": "start-server-and-test start http://localhost:3000 test-MRT",
    "test-cheaters-stats": "start-server-and-test start http://localhost:3000 test-FMGP",
    "test-olympics-athlete-events": "start-server-and-test start http://localhost:3000 test-GGG",
    "test-all": "npm run test-DRP && npm run test-MRT && npm run test-FMGP && npm run test-GGG",
    "test": "npm run build && start-server-and-test start http://localhost:3000 test-all",
    "test:e2e": "start-server-and-test start http://localhost:3000 'npx playwright test'"
  }
